{
  "info": {
    "_postman_id": "5fd7a0e1-2bd7-4e4f-b030-41b50ae3e8df",
    "name": "ERBM API",
    "description": "Collection for the ERBM backend API. Set baseUrl and use Login to populate accessToken automatically. The Advances folder includes PC submission/revision, PM review and ACCOUNTING full disbursement confirmation; switch Login to the required role before each action.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "employeeId", "value": "1" },
    { "key": "projectId", "value": "1" },
    { "key": "advanceId", "value": "" },
    { "key": "activationToken", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.data && body.data.access_token) {", "  pm.collectionVariables.set('accessToken', body.data.access_token);", "}"] } }],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"change-me\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/login" }
        },
        {
          "name": "Refresh access token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.data && body.data.access_token) {", "  pm.collectionVariables.set('accessToken', body.data.access_token);", "}"] } }],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "url": "{{baseUrl}}/auth/refresh" }
        },
        {
          "name": "Logout",
          "request": { "auth": { "type": "noauth" }, "method": "POST", "url": "{{baseUrl}}/auth/logout" }
        },
        {
          "name": "Set initial password",
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{activationToken}}\",\n  \"password\": \"correct-password\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/activation/set-password" }
        },
        {
          "name": "Request activation resend by email",
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/activation/resend" }
        },
        {
          "name": "Get my profile",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/me" }
        }
      ]
    },
    {
      "name": "Roles (ADMIN)",
      "item": [
        { "name": "List roles", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/roles" } }
      ]
    },
    {
      "name": "Employees (ADMIN)",
      "item": [
        {
          "name": "Create employees and send activation links",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "[\n  {\n    \"first_name\": \"Ada\",\n    \"last_name\": \"Lovelace\",\n    \"position\": \"Project Coordinator\",\n    \"email\": \"ada@example.com\",\n    \"date_hired\": \"2026-09-29\",\n    \"role_code\": \"PC\"\n  }\n]", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/employees" }
        },
        { "name": "List employees", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/employees?page=1&page_size=20" } },
        { "name": "Get employee", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/employees/{{employeeId}}" } },
        {
          "name": "Update employee",
          "request": { "method": "PATCH", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"position\": \"Senior Project Coordinator\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/employees/{{employeeId}}" }
        },
        {
          "name": "Deactivate employee",
          "request": { "method": "PATCH", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"employment_end_date\": \"2026-12-31\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/employees/{{employeeId}}/deactivate" }
        },
        { "name": "Resend employee activation link", "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/employees/{{employeeId}}/resend-activation" } }
      ]
    },
    {
      "name": "Projects",
      "item": [
        { "name": "PM dropdown (ACTIVE accounts)", "request": { "method": "GET", "description": "Requires ADMIN, PM or PC. Use user_id as the dropdown value; first_name, last_name and email are labels. A PM creator is assigned automatically as PM.", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/projects/assignees?role=PM&page=1&page_size=20" } },
        { "name": "PC dropdown (ACTIVE accounts, search)", "request": { "method": "GET", "description": "Requires ADMIN, PM or PC. q searches full name or email. A PC creator is assigned automatically as PC; ADMIN/PM may select one PC or leave the project unassigned.", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/projects/assignees?role=PC&q=&page=1&page_size=20" } },
        {
          "name": "Create project (ADMIN, PM, PC)",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"ERBM rollout\",\n  \"description\": \"Initial rollout project\",\n  \"start_date\": \"2026-10-01\",\n  \"end_date\": \"2026-12-31\",\n  \"pm_user_id\": 1,\n  \"pc_user_id\": 2\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/projects" }
        },
        { "name": "List projects", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/projects?page=1&page_size=20&status=ACTIVE" } },
        { "name": "Get project", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/projects/{{projectId}}" } },
        {
          "name": "Update project and assign PC (ADMIN or project PM)",
          "request": { "method": "PATCH", "description": "pc_user_id is one positive user ID. Omit it to preserve the PC assignment, or send null to remove it. Assigned PCs may update only name and description.", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"ERBM rollout - phase 1\",\n  \"pc_user_id\": 2\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/projects/{{projectId}}" }
        },
        {
          "name": "Remove project PC (ADMIN or project PM)",
          "request": { "method": "PATCH", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"pc_user_id\": null\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/projects/{{projectId}}" }
        }
      ]
    },
    {
      "name": "Advances",
      "description": "Advance workflow: PC creates and submits DRAFT -> PENDING_PM_APPROVAL; the assigned PM approves -> APPROVED or returns with a reason -> RETURNED_FOR_REVISION; PC PATCHes a returned request -> DRAFT and submits again. After full payment, ACCOUNTING confirms disbursement -> ACTIVE. Use the same advanceId throughout. Switch accessToken to the acting PC, PM or ACCOUNTING user before each role-specific request. Accounting confirmation requires migration 0006 and a restarted server; no request body is sent. MD paper signature remains outside the system in phase 1.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{accessToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Advances Pending PM Approval (PM)",
          "request": {
            "method": "GET",
            "description": "Use a PM accessToken for the approval screen. The existing Advance list filters PENDING_PM_APPROVAL by Projects currently managed by that PM. Includes standard pagination; an empty list returns data: [] and total: 0.",
            "url": "{{baseUrl}}/advances?status=PENDING_PM_APPROVAL&page=1&page_size=20"
          },
          "response": []
        },
        {
          "name": "Advances Returned for Revision (PC)",
          "request": {
            "method": "GET",
            "description": "Use a PC accessToken. Lists RETURNED_FOR_REVISION Advances in Projects where that PC is currently assigned. Read return reasons with GET /advances/{id}/history; review actions use their corresponding POST APIs.",
            "url": "{{baseUrl}}/advances?status=RETURNED_FOR_REVISION&page=1&page_size=20"
          },
          "response": []
        },
        {
          "name": "Approved Advances (Accounting)",
          "request": {
            "method": "GET",
            "description": "Use an ACCOUNTING accessToken. Lists approved Advances awaiting payment confirmation. Set advanceId to the chosen data item id, pay the full approved amount once, then call Confirm Full Disbursement (Accounting).",
            "url": "{{baseUrl}}/advances?status=APPROVED&page=1&page_size=20"
          },
          "response": []
        },
        {
          "name": "Confirm Full Disbursement (Accounting)",
          "request": {
            "method": "POST",
            "description": "Use an ACCOUNTING accessToken after paying the full approved amount once. No body is required. Transitions APPROVED to ACTIVE and records exact amount, server time, actor and DISBURSE history atomically. Returns 409 for another ACTIVE Advance in the Project, a closed Project, previous payment or non-APPROVED status. Requires migration 0006.",
            "url": "{{baseUrl}}/advances/{{advanceId}}/disburse"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('confirmation succeeded', () => pm.expect(body.success).to.eql(true));",
                  "pm.test('advance is ACTIVE', () => pm.expect(body.data?.status).to.eql('ACTIVE'));",
                  "pm.test('returns the selected advance', () => pm.expect(String(body.data?.id)).to.eql(String(pm.variables.get('advanceId'))));",
                  "pm.test('amount remains exact THB text', () => pm.expect(body.data?.amount).to.be.a('string').and.match(/^[0-9]+\\.[0-9]{2}$/));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 - Full disbursement confirmed",
              "originalRequest": {
                "method": "POST",
                "description": "Use an ACCOUNTING accessToken after paying the full approved amount once. No body is required. Transitions APPROVED to ACTIVE and records exact amount, server time, actor and DISBURSE history atomically. Returns 409 for another ACTIVE Advance in the Project, a closed Project, previous payment or non-APPROVED status. Requires migration 0006.",
                "url": "{{baseUrl}}/advances/{{advanceId}}/disburse"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"message\": \"OK\",\n  \"data\": {\n    \"id\": 7,\n    \"advance_code\": \"ADV-PRJ-2026-000001-001\",\n    \"requester\": {\n      \"user_id\": 25,\n      \"first_name\": \"Somchai\",\n      \"last_name\": \"Jaidee\"\n    },\n    \"project\": {\n      \"id\": 10,\n      \"project_code\": \"PRJ-2026-000001\",\n      \"name\": \"Project A\"\n    },\n    \"purpose\": \"Travel and accommodation\",\n    \"amount\": \"15000.00\",\n    \"status\": \"ACTIVE\",\n    \"created_by\": 25,\n    \"submitted_at\": \"2026-11-17T09:00:00+07:00\",\n    \"created_at\": \"2026-11-17T08:30:00+07:00\",\n    \"updated_at\": \"2026-11-17T10:30:00+07:00\"\n  }\n}"
            },
            {
              "name": "403 - ACCOUNTING role required",
              "originalRequest": {
                "method": "POST",
                "description": "Use an ACCOUNTING accessToken after paying the full approved amount once. No body is required. Transitions APPROVED to ACTIVE and records exact amount, server time, actor and DISBURSE history atomically. Returns 409 for another ACTIVE Advance in the Project, a closed Project, previous payment or non-APPROVED status. Requires migration 0006.",
                "url": "{{baseUrl}}/advances/{{advanceId}}/disburse"
              },
              "status": "Forbidden",
              "code": 403,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"success\": false,\n  \"message\": \"forbidden\"\n}"
            },
            {
              "name": "409 - Another ACTIVE Advance in Project",
              "originalRequest": {
                "method": "POST",
                "description": "Use an ACCOUNTING accessToken after paying the full approved amount once. No body is required. Transitions APPROVED to ACTIVE and records exact amount, server time, actor and DISBURSE history atomically. Returns 409 for another ACTIVE Advance in the Project, a closed Project, previous payment or non-APPROVED status. Requires migration 0006.",
                "url": "{{baseUrl}}/advances/{{advanceId}}/disburse"
              },
              "status": "Conflict",
              "code": 409,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"success\": false,\n  \"message\": \"project already has an ACTIVE advance\"\n}"
            },
            {
              "name": "409 - Not APPROVED or repeated confirmation",
              "originalRequest": {
                "method": "POST",
                "description": "Use an ACCOUNTING accessToken after paying the full approved amount once. No body is required. Transitions APPROVED to ACTIVE and records exact amount, server time, actor and DISBURSE history atomically. Returns 409 for another ACTIVE Advance in the Project, a closed Project, previous payment or non-APPROVED status. Requires migration 0006.",
                "url": "{{baseUrl}}/advances/{{advanceId}}/disburse"
              },
              "status": "Conflict",
              "code": 409,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"success\": false,\n  \"message\": \"advance can only be disbursed in APPROVED\"\n}"
            },
            {
              "name": "409 - Project is closed",
              "originalRequest": {
                "method": "POST",
                "description": "Use an ACCOUNTING accessToken after paying the full approved amount once. No body is required. Transitions APPROVED to ACTIVE and records exact amount, server time, actor and DISBURSE history atomically. Returns 409 for another ACTIVE Advance in the Project, a closed Project, previous payment or non-APPROVED status. Requires migration 0006.",
                "url": "{{baseUrl}}/advances/{{advanceId}}/disburse"
              },
              "status": "Conflict",
              "code": 409,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"success\": false,\n  \"message\": \"project is closed\"\n}"
            }
          ]
        },
        {
          "name": "List Advances",
          "request": {
            "method": "GET",
            "description": "ADMIN and ACCOUNTING can list every accessible Advance. PM sees managed Projects; PC sees assigned Projects. DRAFT records remain visible only to their creator.",
            "url": "{{baseUrl}}/advances?page=1&page_size=20"
          },
          "response": []
        },
        {
          "name": "Create Advance (PC)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('returns Created', () => pm.response.to.have.status(201));",
                  "pm.test('returns an advance ID', () => pm.expect(body.data?.id).to.be.a('number'));",
                  "if (body.data?.id) {",
                  "  pm.collectionVariables.set('advanceId', String(body.data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Requires the authenticated PC to be the Project's assigned coordinator. On a 201 response, the test script stores data.id in advanceId.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": {{projectId}},\n  \"purpose\": \"ค่าเดินทางและที่พัก\",\n  \"amount\": \"15000.00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/advances"
          },
          "response": []
        },
        {
          "name": "Get Advance by ID",
          "request": {
            "method": "GET",
            "description": "Uses advanceId. DRAFT records are visible only to the creator. PM and PC also require current Project membership.",
            "url": "{{baseUrl}}/advances/{{advanceId}}"
          },
          "response": []
        },
        {
          "name": "Update Advance (PC creator)",
          "request": {
            "method": "PATCH",
            "description": "Uses advanceId. Only the PC creator who remains assigned to the Project can update a DRAFT or RETURNED_FOR_REVISION Advance. Omit purpose or amount to retain its current value. A successful PATCH changes RETURNED_FOR_REVISION to DRAFT. Then call Submit Advance (PC) using the same advanceId; submitting directly from RETURNED_FOR_REVISION returns 409.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"ค่าเดินทางและที่พัก (ปรับปรุง)\",\n  \"amount\": \"12000.00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/advances/{{advanceId}}"
          },
          "response": []
        },
        {
          "name": "Submit Advance (PC)",
          "request": {
            "method": "POST",
            "description": "No body required. Submits DRAFT to PENDING_PM_APPROVAL and saves an immutable revision. Returned requests must be edited to DRAFT first. Repeated submission returns 409.",
            "url": "{{baseUrl}}/advances/{{advanceId}}/submit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('awaits PM approval', () => pm.expect(body.data?.status).to.eql('PENDING_PM_APPROVAL'));",
                  "pm.test('has submission time', () => pm.expect(body.data?.submitted_at).to.be.a('string'));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Approve Advance (PM)",
          "request": {
            "method": "POST",
            "description": "Use the Project's current PM accessToken. No body required. Only PENDING_PM_APPROVAL can become APPROVED. Repeated or conflicting review returns 409. APPROVED does not yet allow expenses. After full payment, ACCOUNTING must call Confirm Full Disbursement (Accounting) to make this Advance ACTIVE.",
            "url": "{{baseUrl}}/advances/{{advanceId}}/approve"
          },
          "response": []
        },
        {
          "name": "Return Advance for Revision (PM)",
          "request": {
            "method": "POST",
            "description": "Use the Project's current PM accessToken. Requires a nonblank reason. Only PENDING_PM_APPROVAL can become RETURNED_FOR_REVISION. The reason and action are saved atomically in audit history. Next, the PC reads the RETURN reason in List Advance Action History, PATCHes this same Advance to DRAFT, and submits again.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"กรุณาชี้แจงรายละเอียดค่าเดินทาง\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/advances/{{advanceId}}/return"
          },
          "response": []
        },
        {
          "name": "List Advance Action History",
          "request": {
            "method": "GET",
            "description": "Uses advanceId. Returns every workflow action, newest first by occurred_at and event ID. Includes actor, previous/resulting status, reason and timestamp. SUBMIT also includes revision (numbered from 1 per Advance in event-ID order), amount and purpose from that round. Submission fields are null for other actions; missing snapshot fields remain null. Same Project assignment and private-DRAFT policy as GET detail. No pagination or full audit snapshots. Replaces the separate revisions endpoint. DISBURSE records the Accounting actor and APPROVED -> ACTIVE transition; its revision, amount and purpose are null because it is not a SUBMIT event.",
            "url": "{{baseUrl}}/advances/{{advanceId}}/history"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns history array', () => pm.expect(body.data).to.be.an('array'));",
                  "if (Array.isArray(body.data)) {",
                  "  body.data.forEach((item) => {",
                  "    pm.test('event fields', () => pm.expect(item).to.have.all.keys('id', 'action', 'actor', 'previous_status', 'resulting_status', 'reason', 'revision', 'amount', 'purpose', 'occurred_at'));",
                  "    pm.test('actor ID', () => pm.expect(item.actor.user_id).to.be.a('number'));",
                  "    if (item.action === 'SUBMIT') {",
                  "      pm.test('submission revision', () => pm.expect(item.revision).to.be.a('number').and.be.at.least(1));",
                  "      pm.test('submission purpose', () => pm.expect(item.purpose === null || typeof item.purpose === 'string').to.eql(true));",
                  "    } else {",
                  "      pm.test('no submission data for other actions', () => { pm.expect(item.revision).to.eql(null); pm.expect(item.purpose).to.eql(null); });",
                  "    }",
                  "    if (item.action === 'SUBMIT' && item.amount !== null) {",
                  "      pm.test('exact submitted amount', () => pm.expect(item.amount).to.be.a('string').and.match(/^[0-9]+\\.[0-9]{2}$/));",
                  "    } else {",
                  "      pm.test('nullable amount', () => pm.expect(item.amount).to.eql(null));",
                  "    }",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
