# Server
PORT=8080

# PostgreSQL
# Matches the credentials in docker-compose.yml for local development.
DATABASE_URL=

# JWT
# Replace both secrets with separate long, random values before deployment.
JWT_SECRET=
JWT_ISSUER=erbm
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=168h
REFRESH_COOKIE_SECURE=false

# Login protection
AUTH_LOGIN_LOCK_DURATION=3m
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=10

# Gmail SMTP for account-activation emails
# Create a Google App Password; do not use the Gmail account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_GMAIL_APP_PASSWORD=replace-with-gmail-app-password
SMTP_FROM_ADDRESS=your-gmail-address@gmail.com

# Frontend URL used to build account-activation links.
FRONTEND_ACTIVATION_URL=http://localhost:3000/activate-account
