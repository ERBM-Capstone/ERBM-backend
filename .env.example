# Server
PORT=8080

# PostgreSQL
# Matches the credentials in docker-compose.yml for local development.
DATABASE_URL=

# JWT
# Replace both secrets with separate long, random values before deployment.
JWT_SECRET=
JWT_ISSUER=erbm
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=168h
REFRESH_COOKIE_SECURE=false

# Login protection
AUTH_LOGIN_LOCK_DURATION=3m
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=10

# Gmail SMTP for account-activation emails
# Create a Google App Password; do not use the Gmail account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_GMAIL_APP_PASSWORD=replace-with-gmail-app-password
SMTP_FROM_ADDRESS=your-gmail-address@gmail.com

# Frontend URL used to build account-activation links.
FRONTEND_ACTIVATION_URL=http://localhost:3000/activate-account

# Private receipt storage (already read by config.Load()).
# Use local for development, or gcs with a private bucket and ADC credentials.
RECEIPT_STORAGE_PROVIDER=local
RECEIPT_STORAGE_ROOT=var/receipts
# Required only when RECEIPT_STORAGE_PROVIDER=gcs.
RECEIPT_GCS_BUCKET=

# OCR -> LLM integration through HTTPProvider.
# The backend reads both base URLs and AI_REQUEST_TIMEOUT and activates HTTPProvider.
# Base URLs only: HTTPProvider appends /ocr and /api/extract automatically.
# These localhost URLs assume Go runs on the host, OCR publishes port 8000,
# and LLM uses docker-compose.native.yml, which publishes port 8081.
# For a containerized backend, use addresses reachable from its Docker network.
OCR_BASE_URL=http://localhost:8000
LLM_BASE_URL=http://localhost:8081

# Optional Bearer tokens from the backend to each AI service.
# Token and model variables below are examples; their config wiring is still pending.
# Leave empty for the current local services, which do not require these tokens.
# The OCR gateway's OPENAI_AUTH_TOKEN/OPENAI_API_KEY belongs to the OCR service's
# own environment; it is separate from these service-to-service tokens.
OCR_SERVICE_TOKEN=
LLM_SERVICE_TOKEN=

# Model identifiers recorded in extraction metadata.
# Actual model selection is configured separately in each Python AI service.
OCR_MODEL=typhoon-ocr
LLM_MODEL=scb10x/llama3.1-typhoon2-8b-instruct

# Go duration for the complete OCR + LLM pipeline, not a separate timeout per call.
# Used by HTTPProvider and ExpenseService for the request deadline and lock expiry.
# Defaults to 30s when omitted, invalid, zero or negative; e.g. 2m allows two minutes.
AI_REQUEST_TIMEOUT=30s
